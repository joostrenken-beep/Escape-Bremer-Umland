{
  "name": "escape-bremer-umland",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Outdoor-Escape-Stadtführungen im Bremer Umland als Progressive Web App",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "content": "tsx scripts/build-content.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "icons": "pwa-assets-generator",
    "new-city": "tsx scripts/new-city.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@fontsource/special-elite": "^5.3.0",
    "leaflet": "^1.9.4",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@vite-pwa/assets-generator": "^2.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  }
}
